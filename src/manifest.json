{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.sarti2004.midi-router",
  "name": "MIDI Router",
  "version": "0.1.0-beta.12",
  "description": "Simple MIDI router for Macro Deck. Use it to trigger MD actions from MIDI devices",
  "homepage": "https://github.com/Sarti2004/MIDI-Router",
  "repository": "https://github.com/Sarti2004/MIDI-Router.git",
  "icon": "Assets/icon.png",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/MIDI-Router.dll",
      "runtime": { "kind": "FrameworkDependent", "dotnetVersion": "10.0" }
    },
    "osx-arm64": {
      "executable": "runtimes/osx-arm64/MIDI-Router.dll",
      "runtime": { "kind": "FrameworkDependent", "dotnetVersion": "10.0" }
    }
  },
  "publisher": {
    "name": "Sarti2004"
  },
  "license": "MIT",
  "permissions": [
    "events:publish",
    "host:event-bindings",
    "host:variables",
    "host:config",
    "host:messaging"
  ],
  "compatibility": {
    "macroDeck": ">=3.0.0-beta.14"
  },
  "ai": {
    "interaction": false,
    "generatedContent": false,
    "generatedAssets": false,
    "services": []
  }
}